# ============================================================
# Google Gemini (AI Studio API key) - default LLM + embeddings
# ============================================================
GEMINI_API_KEY=

# LLM configuration
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Embeddings
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ============================================================
# Vector search (open-source default)
# ============================================================
VECTOR_INDEX_NAME=km-documents
FAISS_DIR=./app/db/indices
VECTOR_DIMENSIONS=3072

# ============================================================
# Data
# ============================================================
DATA_FILE_PATH=../data/km_final_output.xlsx

# ============================================================
# Backend selection
#   SEARCH_BACKEND    : faiss | vertex      (vertex falls back to faiss on error)
#   EMBEDDING_BACKEND : gemini | vertex
#   LLM_BACKEND       : gemini | vertex
# ============================================================
SEARCH_BACKEND=faiss
EMBEDDING_BACKEND=gemini
LLM_BACKEND=gemini
VERTEX_ENABLE_FALLBACK=true

# ============================================================
# Google Cloud (shared by Document AI + Vertex AI Search)
# ============================================================
# Project that owns the Document AI processors and Vertex AI Search.
GCP_PROJECT_ID=
# Region for Vertex AI resources (e.g. us-central1, europe-west1).
GCP_LOCATION=us-central1
# Service account JSON path. Leave blank to use gcloud Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
# GCS bucket used for Document AI batch jobs and Vertex AI Search imports.
GCP_STAGING_BUCKET=

# ============================================================
# Document AI (fallback extractor for scanned / complex documents)
# ============================================================
DOCUMENT_AI_ENABLED=true
# "us" or "eu" - must match the location where the processors were created.
DOCUMENT_AI_LOCATION=us
# Enterprise Document OCR processor (scanned pages / images).
DOCUMENT_AI_OCR_PROCESSOR_ID=
# Layout Parser processor (tables, structure, layout-critical docs).
DOCUMENT_AI_LAYOUT_PROCESSOR_ID=
# Files at or below this page count use online (sync) processing; larger use batch.
DOCUMENT_AI_ONLINE_PAGE_LIMIT=15

# ============================================================
# Vertex AI Search (Discovery Engine)
# ============================================================
# "global" or a regional endpoint matching the data store.
VERTEX_LOCATION=global
VERTEX_COLLECTION=default_collection
VERTEX_DATASTORE_ID=
VERTEX_SEARCH_ENGINE_ID=
# Optional app id shown in the Search console (used by import/docs APIs).
VERTEX_SEARCH_APP_ID=
# Vertex embedding model used when EMBEDDING_BACKEND=vertex.
VERTEX_EMBEDDING_MODEL=text-embedding-005

# ============================================================
# Ranking (relevance tiers, %). Vertex scores are on a different
# scale than FAISS - recalibrate after enabling the vertex backend.
# ============================================================
RANKING_TIER_THRESHOLDS=63.5,60.0,55.5
RANKING_RELEVANCE_FLOOR=55.5

# ============================================================
# ETL (folder -> text extraction)
# ============================================================
# Input folder, scanned recursively.
DOCS_INPUT_DIR=./docs
# Where extracted JSONL records + run manifests are written.
ETL_OUTPUT_DIR=./app/db/etl
# Canonical records consumed by `python -m app.services.ingestion --etl`.
ETL_RECORDS_FILE=./app/db/etl/records.jsonl
# Incremental state ledger (skips unchanged files between runs).
ETL_STATE_FILE=./app/db/etl/state.json
# Search granularity: document (default) | chunk
CHUNK_LEVEL=document
# Max chars of extracted text embedded into the document-level vector.
INDEX_MAX_EMBED_CHARS=8000
# Routing thresholds deciding PyMuPDF vs Document AI.
EXTRACT_MIN_CHARS_PER_PAGE=100
EXTRACT_MAX_GARBLED_RATIO=0.2
EXTRACT_MIN_ALNUM_RATIO=0.5
